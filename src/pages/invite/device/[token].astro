---
import Layout from '@/layouts/Layout.astro'
import InviteDeviceForm from '@/components/InviteDeviceForm'

const { token } = Astro.params
if (!token) {
  return Astro.redirect('/login')
}
---

<Layout title="デバイス登録">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <InviteDeviceForm client:load token={token} />
  </main>
</Layout>
