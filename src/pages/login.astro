---
import Layout from '@/layouts/Layout.astro'
import LoginForm from '@/components/LoginForm'
import { safeHandoffNext } from '@/server/auth/app-host'
import { getPageSession } from '@/lib/auth-page'

const next = safeHandoffNext(Astro.url.searchParams.get('next'))
const session = await getPageSession(Astro.cookies)
if (session) {
  if (session.user.mustSetupPasskey) {
    return Astro.redirect('/setup-passkey')
  }
  if (next) {
    return Astro.redirect(next)
  }
  return Astro.redirect(session.user.role === 'admin' ? '/dashboard' : '/posts')
}
---

<Layout title="ログイン">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <LoginForm client:load next={next ?? ''} />
  </main>
</Layout>
