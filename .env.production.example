# Coolify の認証サーバーアプリケーションに置く環境変数のサンプルです。
# 値は Coolify が払い出した接続先と、公開ホストに置き換えてください。
# .env.production は Git に含めません。

# Database
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres-host:5432/postgres

# Prisma ログ: silent | error | warn | info | query
# 未設定時は本番 warn、開発 query。変更は再起動が必要
# DB_LOG_LEVEL="warn"

# Redis
# 認証サーバーは Coolify の Redis リソースが渡すユーザー（通常 default）のまま接続する。
# REDIS_URL="redis://localhost:6379/"
REDIS_URL=redis://default:CHANGE_ME@redis-host:6379/0
# REDIS_KEY_PREFIX=""
# SESSION_MAX_AGE_SECONDS="2592000"
# 設定すると、起動のたびに参加アプリ共通ユーザー app_participant をこのパスワードで用意する。
# 未設定なら作らない。参加アプリの REDIS_URL は次の形にする。
# redis://app_participant:CHANGE_ME@redis-host:6379/0
PARTICIPANT_REDIS_PASSWORD=CHANGE_ME

# App（本番イメージは NODE_ENV=production。公開 URL が未設定だと起動しない）
# APP_URL="http://auth.localhost:3000"
APP_URL=https://auth.example.com
APP_ID=auth
PARENT_DOMAIN=example.com

# WebAuthn（RP ID は認証サーバーのホスト。PARENT_DOMAIN の直下サブドメイン）
# WEBAUTHN_RP_ID="auth.localhost"
WEBAUTHN_RP_ID=auth.example.com
WEBAUTHN_RP_NAME="Astro User WebAuthn"
# WEBAUTHN_ORIGIN="http://auth.localhost:3000"
WEBAUTHN_ORIGIN=https://auth.example.com

# Mail: console (local) | smtp (production)
MAIL_MODE=smtp
SMTP_HOST=email-smtp.ap-northeast-3.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# SMTP_FROM="noreply@example.com"
SMTP_FROM=noreply@example.com

# Seed admin（User が空のときだけ作成。App 行は毎回 upsert。AppGrant は付けない）
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
# 本番（Coolify）: RUN_SEED=true と、既定値以外の SEED_ADMIN_PASSWORD を設定
# NODE_ENV=production のときは既定パスワードでは作成しない
# RUN_SEED=true
