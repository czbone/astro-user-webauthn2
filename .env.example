# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
# Prisma ログ: silent | error | warn | info | query
# 未設定時は本番 warn、開発 query。変更は再起動が必要
# DB_LOG_LEVEL="warn"

# Integration tests (dedicated DB; do not reuse production/dev data)
# docker compose -f docker-compose.db.yaml up -d
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astro_webauthn_test?schema=public"

# Redis (sessions, challenges, rate limits, invite/reset tokens)
REDIS_URL="redis://localhost:6379/"
# REDIS_KEY_PREFIX=""
# SESSION_MAX_AGE_SECONDS="2592000"
# 設定時だけ、起動のたびに参加アプリ共通の Redis ユーザー app_participant を用意する。
# 未設定なら作らない。Coolify の Redis ユーザーは REDIS_URL のまま使う。
# PARTICIPANT_REDIS_PASSWORD="replace-me"

# App（本番イメージは NODE_ENV=production。公開 URL が未設定だと起動しない）
# ローカルは auth.localhost。ポート違いの localhost では __Host- Cookie が混ざる
APP_URL="http://auth.localhost:3000"
APP_ID="auth"
PARENT_DOMAIN="localhost"

# WebAuthn（RP ID は認証サーバーのホスト。親ドメインにはしない）
WEBAUTHN_RP_ID="auth.localhost"
WEBAUTHN_RP_NAME="Astro User WebAuthn"
WEBAUTHN_ORIGIN="http://auth.localhost:3000"

# Mail: console (local) | smtp (production)
MAIL_MODE="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Seed admin（User が空のときだけ作成。App 行は毎回 upsert。AppGrant は付けない）
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin-change-me"
# 本番（Coolify）: RUN_SEED=true と、既定値以外の SEED_ADMIN_PASSWORD を設定
# NODE_ENV=production のときは既定パスワードでは作成しない
# RUN_SEED="true"
